<?xml version="1.0" encoding="UTF-8"?>
<robot name="sbot">
  <group name="manipulator">
    <chain base_link="base_link" tip_link="grasp_link"/>
  </group>

  <group_state name="home" group="manipulator">
    <joint name="joint0" value="0.0"/>
    <joint name="joint1" value="-0.6"/>
    <joint name="joint2" value="1.2"/>
    <joint name="joint3" value="-0.6"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
  </group_state>

  <group_state name="ready" group="manipulator">
    <joint name="joint0" value="0.7"/>
    <joint name="joint1" value="-1.2"/>
    <joint name="joint2" value="1.6"/>
    <joint name="joint3" value="-0.4"/>
    <joint name="joint4" value="0.5"/>
    <joint name="joint5" value="0.0"/>
  </group_state>

  <group name="gripper">
    <link name="grasp_link"/>
  </group>
  <end_effector name="gripper" parent_link="tool0" group="gripper"/>

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>

  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>

  <disable_collisions link1="gripper" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper" link2="wrist_2_link" reason="Never"/>
</robot>
